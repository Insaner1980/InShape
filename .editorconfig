root = true

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
# The existing app shares one journal coordinator across its feature screens.
compose_allowed_forwarding_of_types = JournalViewModel

[app/src/main/java/com/emmah/inshape/ui/components/Controls.kt]
# Pages share the navigation host's snackbar queue.
compose_allowed_composition_locals = LocalPageSnackbar
