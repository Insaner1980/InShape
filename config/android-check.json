{
  "schemaVersion": 1,
  "exceptionsFile": "config/check-exceptions.json",
  "projectId": "inshape",
  "modules": [
    {
      "path": ":app",
      "relativePath": "app",
      "kind": "android-application",
      "required": true,
      "variants": [
        "debug",
        "release"
      ],
      "sourceSets": [
        "main",
        "debug",
        "test",
        "androidTest",
        "sharedTest"
      ]
    }
  ],
  "buildTasks": [
    ":app:assembleDebug"
  ],
  "testTasks": [
    ":app:testDebugUnitTest"
  ],
  "deviceTestTasks": [
    ":app:connectedDebugAndroidTest"
  ],
  "includedBuilds": [],
  "checks": {
    "ktlintReportFormat": "detekt-checkstyle",
    "ktlintTasks": [
      ":app:ktlintCheck"
    ],
    "detektTasks": [
      ":app:detekt"
    ],
    "lintTasks": [
      ":app:lintDebug"
    ],
    "fullLintTasks": [
      ":app:lintDebug",
      ":app:lintRelease"
    ],
    "stabilityTasks": [":app:debugStabilityCheck", ":app:releaseStabilityCheck"],
    "dependencyConfigurations": [
      "debugRuntimeClasspath",
      "releaseRuntimeClasspath"
    ],
    "dependencyCheckTasks": [
      ":app:dependencyCheckAnalyze"
    ],
    "semgrepConfig": "config/semgrep/inshape-security.yml"
  }
}
